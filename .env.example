# Локальная конфигурация AI Delivery Analyst.
# Скопируйте в .env, заполните секреты и выполните: chmod 600 .env

# Обязательный секрет для входа в дашборд.
# Сгенерируйте локально, например: openssl rand -hex 32
ADA_ACCESS_TOKEN=

# Общие учётные данные Jira для серверных профилей.
JIRA_BASE_URL=https://company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Профили содержат идентификаторы и запросы, но не секреты.
# В .env значение должно находиться на одной строке.
ADA_PROFILES=[{"id":"dev","label":"Development","source":"jira","project_key":"DEV","methodology":"scrum","jql":"project = DEV ORDER BY created DESC"}]

# Опциональные учётные данные Trello. Профилю также нужен board_id в ADA_PROFILES.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Локальный запуск. HOST должен быть явным loopback-адресом.
HOST=127.0.0.1
DB_PATH=snapshots.db
SYNC_INTERVAL_SECONDS=3600
ADA_SYNC_WORKERS=2
ADA_SYNC_QUEUE_SIZE=32

# Лимиты загрузки. Превышение лимита или дедлайна отменяет запись снапшота.
ADA_MAX_JIRA_ISSUES=2000
ADA_MAX_JIRA_PAGES=50
ADA_MAX_TRELLO_CARDS=5000
ADA_INGESTION_DEADLINE_SECONDS=300

# Опциональные allowlist. Jira Cloud (*.atlassian.net) и локальные origins
# дашборда разрешены по умолчанию.
ADA_ALLOWED_JIRA_HOSTS=
ADA_ALLOWED_ORIGINS=
ADA_COOKIE_SECURE=0

# Опциональные интеграции.
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
