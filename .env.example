# Local-only AI Delivery Analyst configuration.
# Copy to .env, fill secrets, then run: chmod 600 .env

# Required authentication secret for opening the dashboard.
# Generate locally, for example: openssl rand -hex 32
ADA_ACCESS_TOKEN=

# Shared Jira credentials used only by server-side profiles.
JIRA_BASE_URL=https://company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Profiles contain identifiers and source queries, never credentials.
# Keep this value on one line in .env.
ADA_PROFILES=[{"id":"dev","label":"Development","source":"jira","project_key":"DEV","methodology":"scrum","jql":"project = DEV ORDER BY created DESC"}]

# Optional Trello credentials. Trello profiles also need board_id in ADA_PROFILES.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Local runtime. HOST must be an explicit loopback address.
HOST=127.0.0.1
DB_PATH=snapshots.db
SYNC_INTERVAL_SECONDS=3600
ADA_SYNC_WORKERS=2
ADA_SYNC_QUEUE_SIZE=32

# Ingestion safety limits. Limit/deadline violations abort without a snapshot.
ADA_MAX_JIRA_ISSUES=2000
ADA_MAX_JIRA_PAGES=50
ADA_MAX_TRELLO_CARDS=5000
ADA_INGESTION_DEADLINE_SECONDS=300

# Optional allowlists. Jira Cloud (*.atlassian.net) and local dashboard origins
# are allowed by default.
ADA_ALLOWED_JIRA_HOSTS=
ADA_ALLOWED_ORIGINS=
ADA_COOKIE_SECURE=0

# Optional integrations.
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
